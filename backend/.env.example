# Kopieer dit bestand naar .env en vul de juiste waarden in.
DATABASE_URL="postgresql://kassa:kassa@localhost:5432/kassa?schema=public"
PORT=3000

# Optioneel: Claude API-sleutel voor nauwkeurige factuur-herkenning.
# Zonder sleutel valt de factuur-import terug op lokale (ruwere) PDF-herkenning.
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-opus-5"

# Scrada (facturatie/kasboek/Peppol). Zonder SCRADA_API_KEY draait alles in
# TESTMODUS (dry-run): je ziet wat verstuurd zou worden, er gaat niets weg.
# SCRADA_API_KEY="..."
# SCRADA_BASE_URL="https://api.scrada.be"
# SCRADA_ENDPOINT="/v1/sales-invoices"       # bevestig exact pad via jullie Scrada-account
# SCRADA_AUTH_HEADER="Authorization"          # of bv. "x-api-key" — afhankelijk van Scrada

# Publiek adres van de website, voor de links in de bevestigingsmails.
# SITE_URL="https://www.marché.eu"

# Axepta (BNP Paribas) online betaling voor de webshop: nog NIET gebouwd, klanten
# betalen bij afhaling of levering. Voor de latere koppeling zijn dit de gegevens:
# AXEPTA_MERCHANT_ID="..."
# AXEPTA_HMAC_KEY="..."
# AXEPTA_CRYPTO_KEY="..."
# AXEPTA_BASE_URL="https://paymentpage.axepta.bnpparibas"
